                                ; ---------------------------------------------------------------------------
                                ;	RESIDENT TSR WRAPPER FOR TIKI 100 / TIKO
                                ;
                                ;	FF16h/FF17h is the resident CTC channel-3 vector used by TIKO.
                                ;	The system tick is about 125 Hz (8 ms).	The phase accumulator below
                                ;	converts 125 Hz -> 50 Hz exactly on average: 16,24,16,24... ms spacing.
                                ;	The original TIKO TSR is always chained after our work.
                                ;
                                ;	Resident music API:
                                ;	8000H = TSR interrupt entry (installed in FF16H)
                                ;	8003H = uninstall and mute
                                ;	8006H = install/init (HL = original FF16H vector)
                                ;	8009H = initialize embedded PT3 module
                                ;	800CH = play one PT3 frame manually
                                ;	800FH = mute
                                ;	8012H = pause background playback
                                ;	8015H = resume background playback
                                ;	8018H = status: A=0 playing, A=1 paused
                                ;	801BH = load/start PT3 module at HL; module must remain resident
                                ; ---------------------------------------------------------------------------

  FF16                          CTC3VEC	EQU	0FF16H

  8000                          TSR_INTERRUPT_ENTRY:
  8000    C3 809F               	JP	TIKO_INTERRUPT	;	8000H
  8003                          TSR_STOP_ENTRY:
  8003    C3 808C               	JP	RESIDENT_STOP	;	8003H
  8006                          TSR_INSTALL_ENTRY:
  8006    C3 806F               	JP	RESIDENT_INSTALL	;	8006H
  8009                          MUSIC_INITIALIZE_ENTRY:
  8009    C3 810A               	JP	START	;	8009H
  800C                          MUSIC_PLAY_ENTRY:
  800C    C3 85BE               	JP	PLAY	;	800CH
  800F                          MUSIC_MUTE_ENTRY:
  800F    C3 8115               	JP	MUTE	;	800FH
  8012                          MUSIC_PAUSE_ENTRY:
  8012    C3 801E               	JP	MUSIC_PAUSE	;	8012H
  8015                          MUSIC_RESUME_ENTRY:
  8015    C3 8036               	JP	MUSIC_RESUME	;	8015H
  8018                          MUSIC_STATUS_ENTRY:
  8018    C3 804A               	JP	MUSIC_STATUS	;	8018H
  801B                          MUSIC_LOAD_ENTRY:
  801B    C3 804E               	JP	MUSIC_LOAD	;	801BH

                                ;	Background-music control routines.
                                ;
                                ;	Pause/resume patch the 50 Hz CALL target.	Normal playback therefore pays
                                ;	no per-frame pause-test penalty.
  801E                          MUSIC_PAUSE:
  801E    ED 57                 	LD	A,I	;	P/V = caller IFF2
  8020    F5                    	PUSH	AF
  8021    F3                    	DI
  8022    21 806D               	LD	HL,MUSIC_IDLE
  8025    22 80C4               	LD	(MUSIC_PLAY_TARGET),HL
  8028    3E 01                 	LD	A,1
  802A    32 806E               	LD	(MUSIC_STATE),A
  802D    CD 8115               	CALL	MUTE
  8030    F1                    	POP	AF
  8031    E2 8035               	JP	PO,.PAUSE_RETURN
  8034    FB                    	EI
  8035                          .PAUSE_RETURN:
  8035    C9                    	RET

  8036                          MUSIC_RESUME:
  8036    ED 57                 	LD	A,I	;	preserve caller interrupt state
  8038    F5                    	PUSH	AF
  8039    F3                    	DI
  803A    21 85BE               	LD	HL,PLAY
  803D    22 80C4               	LD	(MUSIC_PLAY_TARGET),HL
  8040    AF                    	XOR	A
  8041    32 806E               	LD	(MUSIC_STATE),A
  8044    F1                    	POP	AF
  8045    E2 8049               	JP	PO,.RESUME_RETURN
  8048    FB                    	EI
  8049                          .RESUME_RETURN:
  8049    C9                    	RET

  804A                          MUSIC_STATUS:
  804A    3A 806E               	LD	A,(MUSIC_STATE)
  804D    C9                    	RET

                                ;	HL points to a PT3 module that must remain resident while it is playing.
  804E                          MUSIC_LOAD:
  804E    ED 57                 	LD	A,I	;	preserve caller interrupt state
  8050    F5                    	PUSH	AF
  8051    F3                    	DI
  8052    E5                    	PUSH	HL
  8053    21 806D               	LD	HL,MUSIC_IDLE
  8056    22 80C4               	LD	(MUSIC_PLAY_TARGET),HL
  8059    E1                    	POP	HL
  805A    CD 8121               	CALL	INIT
  805D    21 85BE               	LD	HL,PLAY
  8060    22 80C4               	LD	(MUSIC_PLAY_TARGET),HL
  8063    AF                    	XOR	A
  8064    32 806E               	LD	(MUSIC_STATE),A
  8067    F1                    	POP	AF
  8068    E2 806C               	JP	PO,.LOAD_RETURN
  806B    FB                    	EI
  806C                          .LOAD_RETURN:
  806C    C9                    	RET

  806D                          MUSIC_IDLE:
  806D    C9                    	RET

  806E                          MUSIC_STATE:
  806E    00                    	DB	0

                                ;	Called by the transient .COM loader after copying us to 8000H.
                                ;	HL contains the original TIKO FF16 vector.
  806F                          RESIDENT_INSTALL:
  806F    22 80D8               	LD	(SAVED_TIKO_VECTOR),HL
  8072    22 80AD               	LD	(FAST_CHAIN_NO_PLAY),HL
  8075    22 80D4               	LD	(FAST_CHAIN_AFTER_PLAY),HL
  8078    AF                    	XOR	A
  8079    32 80A1               	LD	(TICK_PHASE_VALUE),A
  807C    32 806E               	LD	(MUSIC_STATE),A
  807F    32 8114               	LD	(START+10),A	;	PT3, ABC, looping
  8082    21 85BE               	LD	HL,PLAY
  8085    22 80C4               	LD	(MUSIC_PLAY_TARGET),HL
  8088    CD 810A               	CALL	START
  808B    C9                    	RET

                                ;	Uninstall safely, restore TIKO vector, and silence AY.
  808C                          RESIDENT_STOP:
  808C    ED 57                 	LD	A,I	;	preserve caller interrupt state
  808E    F5                    	PUSH	AF
  808F    F3                    	DI
  8090    CD 8115               	CALL	MUTE
  8093    2A 80D8               	LD	HL,(SAVED_TIKO_VECTOR)
  8096    22 FF16               	LD	(CTC3VEC),HL
  8099    F1                    	POP	AF
  809A    E2 809E               	JP	PO,.STOP_RETURN
  809D    FB                    	EI
  809E                          .STOP_RETURN:
  809E    C9                    	RET

                                ;	TIKO CTC3 interrupt hook - TIKI 100 resident path.
                                ;
                                ;	The 125 Hz scheduler touches only AF.	On the three interrupts out of five
                                ;	that do not produce a 50 Hz music tick, AF is restored immediately and the
                                ;	original TIKO handler is chained without a private-stack switch.
                                ;
                                ;	On a music tick the PT3 core runs on the private resident stack.	Static
                                ;	inspection of this fixed PT3 core shows that it uses BC, DE, HL, IX and AF'
                                ;	but neither IY nor EXX.	Only registers the player can actually alter are
                                ;	therefore saved.	If the player core is modified in the future, re-check
                                ;	its register usage before changing this save set.
  809F                          TIKO_INTERRUPT:
  809F    F5                    	PUSH	AF

                                ;	125 Hz -> 50 Hz: phase += 2, fire when phase >= 5.
  80A1                          TICK_PHASE_VALUE	EQU	$+1
  80A0    3E 00                 	LD	A,0
  80A2    C6 02                 	ADD	A,2
  80A4    FE 05                 	CP	5
  80A6    30 07                 	JR	NC,.PLAY50
  80A8    32 80A1               	LD	(TICK_PHASE_VALUE),A
  80AB    F1                    	POP	AF
  80AD                          FAST_CHAIN_NO_PLAY	EQU	$+1
  80AC    C3 0000               	JP	0000H	;	patched with original TIKO handler

  80AF                          .PLAY50:
  80AF    D6 05                 	SUB	5
  80B1    32 80A1               	LD	(TICK_PHASE_VALUE),A

                                	;	AF remains safely stored on the interrupted program's stack.
                                	;	Everything else used by PLAY is saved on our private resident stack.
  80B4    ED 73 80D6            	LD	(SAVED_STACK_POINTER),SP
  80B8    31 810A               	LD	SP,PRIVATE_STACK_TOP
  80BB    C5                    	PUSH	BC
  80BC    D5                    	PUSH	DE
  80BD    E5                    	PUSH	HL
  80BE    DD E5                 	PUSH	IX
  80C0    08                    	EX	AF,AF'
  80C1    F5                    	PUSH	AF
  80C2    08                    	EX	AF,AF'
  80C4                          MUSIC_PLAY_TARGET	EQU	$+1
  80C3    CD 85BE               	CALL	PLAY
  80C6    08                    	EX	AF,AF'
  80C7    F1                    	POP	AF
  80C8    08                    	EX	AF,AF'
  80C9    DD E1                 	POP	IX
  80CB    E1                    	POP	HL
  80CC    D1                    	POP	DE
  80CD    C1                    	POP	BC
  80CE    ED 7B 80D6            	LD	SP,(SAVED_STACK_POINTER)
  80D2    F1                    	POP	AF
  80D4                          FAST_CHAIN_AFTER_PLAY	EQU	$+1
  80D3    C3 0000               	JP	0000H	;	patched with original TIKO handler

  80D6                          SAVED_STACK_POINTER:
  80D6    0000                  		DW	0

  80D8                          SAVED_TIKO_VECTOR:
  80D8    0000                  		DW	0

                                	;	48-byte private music stack.
                                	;	Full-song profiling measured a 0010H (16-byte) high-water mark.
                                	;	48 bytes keeps a 3x measured safety margin.
  80DA                          PRIVATE_STACK_BASE:
  80DA                          		DS	48
