  8000                          TSRINT:
  8000    C3 802C               	JP	RESTSR	; 8000H
  8003                          TSRSTP:
  8003    C3 8020               	JP	RESSTP	; 8003H
  8006                          TSRINS:
  8006    C3 8012               	JP	RESINS	; 8006H
  8009                          MUSINI:
