BLOKK-KOPIERING
---------------

getbar(w,h,&buf)	Kopier skjermomr}de til buffer
putbar(w,h,&buf)	Kopier buffer til skjerm
getblk(&m,x,y,dx,dy)	DS_GBIB blokkformat: hent blokk
putblk(&m,x,y)	Legg blokk
ovrblk(&m,x,y)	Legg blokk med OR
undblk(&m,x,y)	Legg blokk med AND
getbs(dx,dy)	Beregn bufferst|rrelse: (dx+1)*(dy+1)+4
getbbs(dx,dy)	 Alias/DS_GBIB B-blokk st|rrelse
getbbk(&m,x,y,dx,dy)
putbbk(&m,x,y)
ovrbbk(&m,x,y)
undbbk(&m,x,y)

