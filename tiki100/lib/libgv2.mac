	LD	(ARCFR),DE
	LD	HL,2
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(ARCDL),DE
	LD	HL,(ARCDL)
	BIT	7,H
	JR	Z,ARC_P
	LD	A,H
	CPL
	LD	H,A
	LD	A,L
	CPL
	LD	L,A
	INC	HL
ARC_P:
	LD	DE,10
	CALL	ARCDIV
	INC	HL
	LD	A,L
	OR	A
	RET	Z
	LD	(ARCN),A
	LD	HL,(ARCDL)
	LD	A,(ARCN)
	LD	E,A
	LD	D,0
	BIT	7,H
	JR	Z,ARC_Q
	PUSH	HL
	LD	A,H
	CPL
	LD	H,A
	LD	A,L
	CPL
	LD	L,A
	INC	HL
	CALL	ARCDIV
	LD	A,H
	CPL
	LD	H,A
	LD	A,L
	CPL
	LD	L,A
	INC	HL
	JR	ARC_R
ARC_Q:
	CALL	ARCDIV
ARC_R:
	LD	(ARCST),HL
	LD	HL,(ARCFR)
	LD	(ARCCUR),HL
	CALL	ARCPT
	LD	HL,(APTX)
	LD	(ARCOX),HL
	LD	HL,(APTY)
	LD	(ARCOY),HL
	LD	A,(ARCN)
	LD	B,A
ARCLP:
	PUSH	BC
	LD	HL,(ARCCUR)
	LD	DE,(ARCST)
	ADD	HL,DE
	LD	(ARCCUR),HL
	CALL	ARCPT
	LD	HL,(ARCOX)
	LD	(GX),HL
	LD	HL,(ARCOY)
	LD	(GY),HL
	LD	HL,(APTX)
	LD	DE,(ARCOX)
	OR	A
	SBC	HL,DE
	LD	(G1),HL
	LD	HL,(APTY)
	LD	DE,(ARCOY)
	OR	A
	SBC	HL,DE
	LD	(G2),HL
	LD	A,12
	CALL	GIOCL
	LD	HL,(APTX)
	LD	(ARCOX),HL
	LD	HL,(APTY)
	LD	(ARCOY),HL
	POP	BC
	DJNZ	ARCLP
	RET

ARCPT:
	LD	HL,(ARCCUR)
	CALL	TGETSIN
	LD	HL,(ARCRY)
	CALL	TMULS
	CALL	TDIV128
	LD	DE,(ARCY)
	ADD	HL,DE
	LD	(APTY),HL
	LD	HL,(ARCCUR)
	LD	DE,90
	ADD	HL,DE
	CALL	TGETSIN
	LD	HL,(ARCRX)
	CALL	TMULS
	CALL	TDIV128
	LD	DE,(ARCX)
	ADD	HL,DE
	LD	(APTX),HL
	RET

ARCDIV:
	LD	B,H
	LD	C,L
	LD	HL,0
	LD	A,16
ARCD1:
	RL	C
	RL	B
	ADC	HL,HL
	SBC	HL,DE
	JR	NC,ARCD2
	ADD	HL,DE
ARCD2:
	CCF
	DEC	A
	JR	NZ,ARCD1
	RL	C
	RL	B
	LD	H,B
	LD	L,C
	RET

ARCX:	DW	0
ARCY:	DW	0
