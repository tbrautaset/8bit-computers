	INC	HL
	LD	D,(HL)
	LD	(KYP),DE
	LD	HL,(KPN)
	LD	A,H
	OR	A
	RET	NZ
	LD	A,L
	CP	2
	RET	C
	DEC	A
	LD	(KPCNT),A
	LD	HL,(KXP)
	CALL	KRDW
	LD	(KX1),DE
	LD	HL,(KYP)
	CALL	KRDW
	LD	(KY1),DE
	LD	HL,(KXP)
