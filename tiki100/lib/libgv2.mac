	LD	HL,(ERX2)
	LD	DE,(ERY)
	CALL	MUL16
	LD	DE,(ED)
	EX	DE,HL
	OR	A
	SBC	HL,DE
	LD	DE,(ERX2)
	ADD	HL,DE
	LD	(ED),HL
	LD	HL,0
	LD	(EPX),HL
	LD	HL,(ERX2)
	ADD	HL,HL
	LD	DE,(ERY)
	CALL	MUL16
	LD	(EPY),HL
EL_R1:
	CALL	EPLOT4
	LD	HL,(EX)
	INC	HL
	LD	(EX),HL
	LD	HL,(ERY2)
	ADD	HL,HL
	LD	DE,(EPX)
	ADD	HL,DE
	LD	(EPX),HL
	LD	HL,(ED)
	BIT	7,H
	JR	Z,EL_R1P
	LD	DE,(ERY2)
	ADD	HL,DE
	LD	DE,(EPX)
	ADD	HL,DE
	LD	(ED),HL
	JR	EL_R1C
EL_R1P:
	LD	DE,(ERY2)
	ADD	HL,DE
	LD	DE,(EPX)
	ADD	HL,DE
	PUSH	HL
	LD	HL,(ERX2)
	ADD	HL,HL
	EX	DE,HL
	LD	HL,(EPY)
	OR	A
	SBC	HL,DE
	LD	(EPY),HL
	EX	DE,HL
	POP	HL
	OR	A
	SBC	HL,DE
	LD	DE,(ERX2)
	ADD	HL,DE
	ADD	HL,DE
	LD	(ED),HL
	LD	HL,(EY)
	DEC	HL
	LD	(EY),HL
EL_R1C:
	LD	HL,(EPX)
	LD	DE,(EPY)
	OR	A
	SBC	HL,DE
	JR	C,EL_R1
	LD	HL,(ERY2)
	LD	DE,(EX)
	INC	DE
	CALL	MUL16
	PUSH	HL
	LD	HL,(ERX2)
	LD	DE,(EY)
	DEC	DE
	CALL	MUL16
	POP	DE
	ADD	HL,DE
	LD	DE,(ERX2)
	PUSH	HL
	LD	HL,(ERY2)
	EX	DE,HL
	CALL	MUL16
	EX	DE,HL
	POP	HL
	OR	A
	SBC	HL,DE
	LD	(ED),HL
EL_R2:
	LD	HL,(EY)
	LD	A,H
	OR	L
	RET	Z
	BIT	7,H
	RET	NZ
	CALL	EPLOT4
	LD	HL,(EY)
	DEC	HL
	LD	(EY),HL
	LD	HL,(ERX2)
	ADD	HL,HL
	EX	DE,HL
	LD	HL,(EPY)
	OR	A
	SBC	HL,DE
	LD	(EPY),HL
	LD	HL,(ED)
	BIT	7,H
	JR	NZ,EL_R2N
	LD	DE,(ERX2)
