TSINCOS:
	LD	HL,(TANG)
TSC0:
	BIT	7,H
	JR	Z,TSC1
	LD	DE,360
	ADD	HL,DE
	JR	TSC0
TSC1:
	LD	DE,360
	OR	A
	SBC	HL,DE
	JR	C,TSC2
	JR	TSC1
TSC2:
	ADD	HL,DE
	LD	(TTEMP),HL
	CALL	TGETSIN
	LD	(TSVAL),DE
	LD	HL,(TTEMP)
	LD	BC,90
	ADD	HL,BC
	CALL	TGETSIN
	LD	(TCVAL),DE
	RET

TGETSIN:
TGS0:
	BIT	7,H
	JR	Z,TGS1
	LD	DE,360
	ADD	HL,DE
	JR	TGS0
TGS1:
	LD	DE,360
	OR	A
	SBC	HL,DE
	JR	C,TGS2
	JR	TGS1
TGS2:
	ADD	HL,DE
	LD	DE,180
	OR	A
	SBC	HL,DE
	JR	C,TGS3
	CALL	TGSPOS
	LD	A,D
	CPL
	LD	D,A
	LD	A,E
	CPL
	LD	E,A
	INC	DE
	RET
TGS3:
	ADD	HL,DE
TGSPOS:
	LD	DE,90
	OR	A
	SBC	HL,DE
	JR	C,TGS4
	EX	DE,HL
	LD	HL,90
	OR	A
	SBC	HL,DE
	JR	TGS5
TGS4:
	ADD	HL,DE
TGS5:
	LD	DE,SIN90
	ADD	HL,DE
	LD	A,(HL)
	LD	E,A
	LD	D,0
	RET

TMULS:
	LD	A,H
	XOR	D
	PUSH	AF
	BIT	7,H
	JR	Z,TMS1
	CALL	TNEG16
TMS1:
	BIT	7,D
	JR	Z,TMS2
	EX	DE,HL
	CALL	TNEG16
	EX	DE,HL
TMS2:
	LD	B,H
	LD	C,L
	LD	HL,0
	LD	A,16
TMS3:
	ADD	HL,HL
	RL	C
	RL	B
	JR	NC,TMS4
	ADD	HL,DE
TMS4:
	DEC	A
	JR	NZ,TMS3
	POP	AF
	BIT	7,A
	RET	Z
TNEG16:
	LD	A,H
	CPL
	LD	H,A
	LD	A,L
	CPL
	LD	L,A
	INC	HL
	RET

TDIV128:
	SRA	H
	RR	L
	SRA	H
	RR	L
	SRA	H
	RR	L
	SRA	H
	RR	L
	SRA	H
	RR	L
	SRA	H
	RR	L
	SRA	H
	RR	L
	RET

SIN90:
	DB	0,2,4,7,9,11,13,16,18,20,22,24,27,29,31,33
	DB	35,37,40,42,44,46,48,50,52,54,56,58,60,62,64,66
	DB	68,70,72,73,75,77,79,81,82,84,86,87,89,91,92,94
	DB	95,97,98,99,101,102,104,105,106,107,109,110,111,112,113,114
	DB	115,116,117,118,119,119,120,121,122,122,123,124,124,125,125,126
	DB	126,126,127,127,127,128,128,128,128,128,128

