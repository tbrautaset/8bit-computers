	ADD	HL,DE
	LD	(EPX),HL
	LD	HL,(ED)
	LD	DE,(ERX2)
	ADD	HL,DE
	LD	DE,(EPX)
	ADD	HL,DE
	LD	DE,(EPY)
	OR	A
	SBC	HL,DE
	LD	(ED),HL
	JR	EL_R2

EPLOT4:
	LD	HL,(ECX)
	LD	DE,(EX)
	ADD	HL,DE
	LD	(GX),HL
	LD	HL,(ECY)
	LD	DE,(EY)
	ADD	HL,DE
	LD	(GY),HL
	CALL	DOT
	LD	HL,(ECX)
	LD	DE,(EX)
	OR	A
	SBC	HL,DE
	LD	(GX),HL
	CALL	DOT
	LD	HL,(ECX)
	LD	DE,(EX)
	ADD	HL,DE
	LD	(GX),HL
	LD	HL,(ECY)
	LD	DE,(EY)
	OR	A
	SBC	HL,DE
	LD	(GY),HL
	CALL	DOT
	LD	HL,(ECX)
	LD	DE,(EX)
	OR	A
	SBC	HL,DE
	LD	(GX),HL
	CALL	DOT
	RET

KARC:
	LD	HL,12
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(ARCX),DE
	LD	HL,10
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
