; ==========================================================
; LIBGV2.MAC
;
; Biblioteksfil, rekonstruerte TurboPascal biblioteker
; fra Tiki-Data AS for bruk av Tiki grafikk og lyd i
; Macro-80 og Small-C.
;
; Prosedyrer som ikke brukes kan slettes for å spare plass.
;
; Basert på arbeider av Egil Kvaleberg (LIBG),
; Kim G.S. \yhus (DS_GBIB) og Jarle Strand (LYD)
; ==========================================================
;	
; Rekonstruksjon og integrasjon:
; Tom Brautaset
;
; GRAFIKK:	ginit ink defink apos block rline aline dot fill circle
; TEKST:	txt ch chsize font txtdir gbtxt txtsiz
; FORMER:	kellip karc rect rectf kpoly line
; BLOKK:	getbar putbar getblk putblk ovrblk undblk getbs
; TURTLE:	tturto tturn tmove tline tmovto tmovby tlinto tlinby tplot
;		tarc tellip trect
; LYD:		sound nosnd ayreg aywr
; MODUS:	gmode wrtm ltyp clipon clipof defclp viewport scroll
; FARGE:	setpen getpen setbg getbg setpmd getpmd setbgc getbgc
; ANNET:	gio gcb gpar curpos curink getpix hardcopy cpy clrscr cls
;
	.Z80
	TITLE	'LIBGV2'
	PUBLIC	GINIT
	PUBLIC	CLS
	PUBLIC	SETMOD
	PUBLIC	GETMOD
	PUBLIC	INK
	PUBLIC	APOS
	PUBLIC	DOT
	PUBLIC	GPIX
	PUBLIC	BLOCK
	PUBLIC	RLINE
	PUBLIC	TXT
	PUBLIC	CH
	PUBLIC	FILL
	PUBLIC	SOUND
	PUBLIC	HARDCOPY
	PUBLIC	GMODE
	PUBLIC	WRTM
	PUBLIC	CURINK
	PUBLIC	CURPOS
	PUBLIC	RPOS
	PUBLIC	ALINE
	PUBLIC	LTYP
	PUBLIC	CIRCLE
	PUBLIC	DEFCOL
	PUBLIC	SETPEN
	PUBLIC	GETPEN
	PUBLIC	SETBG
	PUBLIC	GETBG
	PUBLIC	SETPMD
	PUBLIC	GETPMD
	PUBLIC	SETTRN
	PUBLIC	GETTRN
	PUBLIC	SETPAT
	PUBLIC	CLIPON
	PUBLIC	CLIPOF
	PUBLIC	DEFCLP
	PUBLIC	SETCLP
	PUBLIC	PLOT
	PUBLIC	PPLOT
	PUBLIC	POINT
	PUBLIC	LINE
	PUBLIC	PLINE
	PUBLIC	RECT
	PUBLIC	RECTF
	PUBLIC	GETBAR
	PUBLIC	PUTBAR
	PUBLIC	GETBLK
	PUBLIC	PUTBLK
	PUBLIC	OVRBLK
	PUBLIC	UNDBLK
	PUBLIC	TTURTO
	PUBLIC	TTURN
	PUBLIC	TMOVE
	PUBLIC	TMOVTO
	PUBLIC	TMOVBY
	PUBLIC	TLINE
	PUBLIC	TLINTO
	PUBLIC	TLINBY
	PUBLIC	TPLOT
	PUBLIC	TRECT
	PUBLIC	KELLIP
	PUBLIC	KARC
	PUBLIC	KPOLY
	PUBLIC	KGPOLY
	PUBLIC	KFLOOD
	PUBLIC	KBOUND
	PUBLIC	NOSND
	PUBLIC	AYREG
	PUBLIC	AYWR
	PUBLIC	TSCALE
	PUBLIC	BCHD
	PUBLIC	BCHW
	PUBLIC	BGETX
	PUBLIC	BGETY
	PUBLIC	BOUNDF
	PUBLIC	BSCUR
	PUBLIC	BSETCU
	PUBLIC	BSETFN
	PUBLIC	BSETPN
	PUBLIC	BSTDFN
	PUBLIC	CHSIZE
	PUBLIC	CLRSCR
	PUBLIC	CPY
	PUBLIC	DEFINK
	PUBLIC	FLOODF
	PUBLIC	FONT
	PUBLIC	GBTXT
	PUBLIC	GCB
	PUBLIC	GETBBK
	PUBLIC	GETBGC
	PUBLIC	GETPIX
	PUBLIC	GIO
	PUBLIC	GPAR
	PUBLIC	OVRBBK
	PUBLIC	PUTBBK
	PUBLIC	SCROLL
	PUBLIC	SETBGC
	PUBLIC	SETFNT
	PUBLIC	STDFNT
	PUBLIC	TARC
	PUBLIC	TELLIP
	PUBLIC	TXTDIR
	PUBLIC	TXTSIZ
	PUBLIC	UNDBBK
	PUBLIC	VIEWPORT
	PUBLIC	GETBS
	PUBLIC	GETBBS
	PUBLIC	TICKON
	PUBLIC	TICKOF
	PUBLIC	TICKGET
	PUBLIC	TICKCLR
	PUBLIC	CUROFF
	PUBLIC	CURON

CLRSCR:
	LD	E,25
	LD	C,2
	CALL	5
	RET

GINIT:
	XOR	A
	LD	(WM),A
	LD	HL,0000H
	LD	(CLIPFG),HL
	LD	(CLX1),HL
	LD	(CLY1),HL
	LD	HL,00FFH
	LD	(CLX2),HL
	LD	(CLY2),HL
	LD	A,4
	CALL	GIOCL
	RET

INK:
	POP	DE
	POP	HL
	PUSH	HL
	PUSH	DE
	LD	(G1),HL
	LD	A,L
	LD	(GC),A
	LD	A,7
	JP	GIOCL

APOS:
	POP	BC
	POP	HL
	POP	DE
	PUSH	DE
	PUSH	HL
	PUSH	BC
	LD	(GX),DE
	LD	(GY),HL
	RET

BLOCK:
	POP	BC
	POP	HL
	POP	DE
	PUSH	DE
	PUSH	HL
	PUSH	BC
	LD	(G1),DE
	LD	(G2),HL
	LD	HL,(CLIPFG)
	LD	A,H
	OR	L
	JP	NZ,BLKSW
	LD	A,(WM)
	OR	A
	JP	NZ,BLKSW
	LD	A,10
	JP	GIOCL

BLKSW:
	CALL	BLKCLP
	RET	C
	JP	CBLOCK

RLINE:
	POP	BC
	POP	HL
	POP	DE
	PUSH	DE
	PUSH	HL
	PUSH	BC
	LD	(G1),DE
	LD	(G2),HL
	LD	HL,(CLIPFG)
	LD	A,H
	OR	L
	JR	NZ,RLNSW
	LD	A,(WM)
	OR	A
	JR	NZ,RLNSW
	LD	A,12
	JP	GIOCL

RLNSW:
	LD	DE,(G1)
	LD	(SLDX),DE
	LD	HL,(G2)
	LD	(SLDY),HL
	LD	HL,(GX)
	LD	(LX1),HL
	ADD	HL,DE
	LD	(LX2),HL
	LD	HL,(GY)
	LD	(LY1),HL
	LD	DE,(SLDY)
	ADD	HL,DE
	LD	(LY2),HL
	CALL	SLINE
	LD	HL,(LX2)
	LD	(GX),HL
	LD	HL,(LY2)
	LD	(GY),HL
	RET

TXT:
	POP	DE
	POP	HL
	PUSH	HL
	PUSH	DE
TXTLP:
	LD	A,(HL)
	OR	A
	RET	Z
	PUSH	HL
	LD	(G1),A
	XOR	A
	LD	(G1H),A
	LD	A,11
	CALL	GIOCL
	POP	HL
	INC	HL
	JR	TXTLP

DOT:
	CALL	CLPCHK
	RET	C
	LD	A,(WM)
	OR	A
	JP	Z,DOTRAW
DOTCMP:
	LD	A,(GC)
	AND	03H
	LD	(CPEN),A
	CALL	GPIX
	LD	A,L
	AND	03H
	LD	B,A
	LD	A,(CPEN)
	LD	C,A
	LD	A,(WM)
	CP	01H
	JP	Z,DCOR
	CP	02H
	JP	Z,DCXOR
	CP	03H
	JP	Z,DCAND
	LD	A,C
	JP	DCSET

DCOR:
	LD	A,B
	OR	C
	JP	DCSET

DCXOR:
	LD	A,B
	XOR	C
	JP	DCSET

DCAND:
	LD	A,B
	AND	C

DCSET:
	AND	03H
	LD	(GC),A
	LD	A,9
	CALL	GIOCL
	LD	A,(CPEN)
	LD	(GC),A
	RET

DOTRAW:
	LD	A,9
	JP	GIOCL

GMODE:
	POP	DE
	POP	HL
	; mode
	PUSH	HL
	PUSH	DE
	LD	A,L
	OR	H
	JR	Z,GMSKIP
	LD	(G1),HL
	LD	HL,1
	LD	(G2),HL
	LD	A,1
	CALL	GIOCL
GMSKIP:
	LD	A,5
	CALL	GIOCL
	LD	HL,(G1)
	RET

DEFINK:
	POP	IX
	POP	BC
	POP	DE
	POP	HL
	PUSH	HL
	PUSH	DE
	PUSH	BC
	PUSH	IX
	CALL	SKAL100
	LD	(G1),HL
	EX	DE,HL
	CALL	SKAL100
	LD	(G2),HL
	LD	H,B
	LD	L,C
	CALL	SKAL100
	LD	(G3),HL
	LD	A,2
	JP	GIOCL

SKAL100:
	PUSH	DE
	LD	A,H
	OR	A
	JR	NZ,SKALMAX
	LD	A,L
	CP	101
	JR	NC,SKALMAX
	LD	E,L
	LD	D,0
	LD	HL,SKALTAB
	ADD	HL,DE
	LD	L,(HL)
	LD	H,0
	POP	DE
	RET
SKALMAX:
	POP	DE
	LD	HL,255
	RET

SKALTAB:
	DB	0,2,5,7,10,12,15,17,20,22,25,28,30,33,35,38
	DB	40,43,45,48,51,53,56,58,61,63,66,68,71,73,76,79
	DB	81,84,86,89,91,94,96,99,102,104,107,109,112,114,117,119
	DB	122,124,127,130,132,135,137,140,142,145,147,150,153,155,158,160
	DB	163,165,168,170,173,175,178,181,183,186,188,191,193,196,198,201
	DB	204,206,209,211,214,216,219,221,224,226,229,232,234,237,239,242
	DB	244,247,249,252,255

WRTM:
	POP	DE
	POP	HL
	PUSH	HL
	PUSH	DE
	LD	A,L
	LD	(WM),A
	RET

CURINK:
	LD	A,16
	CALL	GIOCL
	LD	HL,(G1)
	RET

CURPOS:
	POP	BC
	POP	HL
	POP	DE
	PUSH	DE
	PUSH	HL
	PUSH	BC
	PUSH	HL
	LD	HL,(GX)
	CALL	SWDE
	POP	DE
	LD	HL,(GY)
	CALL	SWDE
	RET

RPOS:
	POP	BC
	POP	HL
	POP	DE
	PUSH	DE
	PUSH	HL
	PUSH	BC
	LD	(T0),HL
	LD	HL,(GX)
	ADD	HL,DE
	LD	(GX),HL
	LD	DE,(T0)
	LD	HL,(GY)
	ADD	HL,DE
	LD	(GY),HL
	RET

ALINE:
	POP	BC
	POP	HL
	LD	(LY2),HL
	POP	HL
	LD	(LX2),HL
	PUSH	HL
	LD	HL,(LY2)
	PUSH	HL
	PUSH	BC
	LD	HL,(CLIPFG)
	LD	A,H
	OR	L
	JR	NZ,ALNSW
	LD	A,(WM)
	OR	A
	JR	NZ,ALNSW
	LD	HL,(LX2)
	LD	DE,(GX)
	OR	A
	SBC	HL,DE
	LD	(G1),HL
	LD	HL,(LY2)
	LD	DE,(GY)
	OR	A
	SBC	HL,DE
	LD	(G2),HL
	LD	A,12
	CALL	GIOCL
	LD	HL,(LX2)
	LD	(GX),HL
	LD	HL,(LY2)
	LD	(GY),HL
	RET

ALNSW:
	LD	HL,(GX)
	LD	(LX1),HL
	LD	HL,(GY)
	LD	(LY1),HL
	CALL	SLINE
	LD	HL,(LX2)
	LD	(GX),HL
	LD	HL,(LY2)
	LD	(GY),HL
	RET

LTYP:
	POP	DE
	POP	HL
	PUSH	HL
	PUSH	DE
	LD	A,L
	LD	(LT),A
	RET

CIRCLE:
	POP	BC
	POP	HL
	LD	(CRAD),HL
	POP	HL
	LD	(CRX),HL
	PUSH	HL
	LD	HL,(CRAD)
	PUSH	HL
	PUSH	BC
	LD	HL,(GX)
	LD	(CCX),HL
	LD	HL,(GY)
	LD	(CCY),HL
	XOR	A
	LD	(COX),A
	LD	HL,(CRAD)
	LD	A,L
	OR	A
	RET	Z
	LD	(COY),A
	LD	HL,3
	LD	A,(COY)
	ADD	A,A
	LD	E,A
	LD	D,0
	OR	A
	SBC	HL,DE
	LD	(CERR),HL
CLOOP:
	CALL	CPLOT8
	LD	HL,(CERR)
	LD	A,H
	AND	80H
	JP	NZ,CNEG
	LD	A,(COX)
	CALL	CMUL4
	LD	HL,(CERR)
	ADD	HL,DE
	LD	A,(COY)
	CALL	CMUL4
	OR	A
	SBC	HL,DE
	LD	DE,10
	ADD	HL,DE
	LD	(CERR),HL
	LD	A,(COY)
	DEC	A
	LD	(COY),A
	JP	CINCX
CNEG:
	LD	A,(COX)
	CALL	CMUL4
	LD	HL,(CERR)
	ADD	HL,DE
	LD	DE,6
	ADD	HL,DE
	LD	(CERR),HL
CINCX:
	LD	A,(COX)
	INC	A
	LD	(COX),A
	LD	B,A
	LD	A,(COY)
	CP	B
	JP	NC,CLOOP
	RET

CMUL4:
	ADD	A,A
	ADD	A,A
	LD	E,A
	LD	D,0
	RET

CADDHL:
	LD	E,A
	LD	D,0
	ADD	HL,DE
	RET

CSUBHL:
	LD	E,A
	LD	D,0
	OR	A
	SBC	HL,DE
	RET

CSETDOT:
	LD	(GX),HL
	EX	DE,HL
	LD	(GY),HL
	CALL	DOT
	RET

CPLOT8:
	LD	A,(COX)
	LD	HL,(CCX)
	CALL	CADDHL
	PUSH	HL
	LD	A,(COY)
	LD	HL,(CCY)
	CALL	CADDHL
	EX	DE,HL
	POP	HL
	CALL	CSETDOT
	LD	A,(COX)
	LD	HL,(CCX)
	CALL	CSUBHL
	PUSH	HL
	LD	A,(COY)
	LD	HL,(CCY)
	CALL	CADDHL
	EX	DE,HL
	POP	HL
	CALL	CSETDOT
	LD	A,(COX)
	LD	HL,(CCX)
	CALL	CADDHL
	PUSH	HL
	LD	A,(COY)
	LD	HL,(CCY)
	CALL	CSUBHL
	EX	DE,HL
	POP	HL
	CALL	CSETDOT
	LD	A,(COX)
	LD	HL,(CCX)
	CALL	CSUBHL
	PUSH	HL
	LD	A,(COY)
	LD	HL,(CCY)
	CALL	CSUBHL
	EX	DE,HL
	POP	HL
	CALL	CSETDOT
	LD	A,(COY)
	LD	HL,(CCX)
	CALL	CADDHL
	PUSH	HL
	LD	A,(COX)
	LD	HL,(CCY)
	CALL	CADDHL
	EX	DE,HL
	POP	HL
	CALL	CSETDOT
	LD	A,(COY)
	LD	HL,(CCX)
	CALL	CSUBHL
	PUSH	HL
	LD	A,(COX)
	LD	HL,(CCY)
	CALL	CADDHL
	EX	DE,HL
	POP	HL
	CALL	CSETDOT
	LD	A,(COY)
	LD	HL,(CCX)
	CALL	CADDHL
	PUSH	HL
	LD	A,(COX)
	LD	HL,(CCY)
	CALL	CSUBHL
	EX	DE,HL
	POP	HL
	CALL	CSETDOT
	LD	A,(COY)
	LD	HL,(CCX)
	CALL	CSUBHL
	PUSH	HL
	LD	A,(COX)
	LD	HL,(CCY)
	CALL	CSUBHL
	EX	DE,HL
	POP	HL
	CALL	CSETDOT
	RET

CRAD:	DW	0000H
CRX:	DW	0000H
CCX:	DW	0000H
CCY:	DW	0000H
COX:	DB	00H
COY:	DB	00H
CERR:	DW	0000H

CPY:
	POP	IX
	POP	BC
	LD	(T3),BC
	POP	HL
	LD	(G3),HL
	POP	DE
	LD	(G2),DE
	POP	HL
	LD	(G1),HL
	PUSH	HL
	PUSH	DE
	LD	HL,(G3)
	PUSH	HL
	LD	HL,(T3)
	PUSH	HL
	PUSH	IX
	LD	A,20
	JP	GIOCL

CHSIZE:
	POP	BC
	POP	HL
	LD	(T2),HL
	POP	DE
	LD	(T1),DE
	POP	HL
	PUSH	HL
	PUSH	DE
	LD	DE,(T2)
	PUSH	DE
	PUSH	BC
	LD	(G1),HL
	LD	A,19
	CALL	GIOCL
	LD	DE,(T1)
	LD	HL,(G1)
	CALL	SWDE
	LD	DE,(T2)
	LD	HL,(G2)
	CALL	SWDE
	RET

FONT:
	POP	DE
	POP	HL
	PUSH	HL
	PUSH	DE
	LD	(GF),HL
	RET

SCROLL:
	POP	DE
	POP	HL
	PUSH	HL
	PUSH	DE
	LD	(G1),HL
	LD	A,3
	JP	GIOCL

GPAR:
	POP	BC
	POP	HL
	LD	(T2),HL
	POP	DE
	LD	(T1),DE
	POP	HL
	LD	(T0),HL
	PUSH	HL
	PUSH	DE
	LD	HL,(T2)
	PUSH	HL
	PUSH	BC
	LD	A,5
	CALL	GIOCL
	LD	DE,(T0)
	LD	HL,(G1)
	CALL	SWDE
	LD	DE,(T1)
	LD	HL,(G2)
	CALL	SWDE
	LD	DE,(T2)
	LD	HL,(G3)
	CALL	SWDE
	RET

FILL:
	POP	DE
	POP	HL
	PUSH	HL
	PUSH	DE
	LD	(G1),HL
	LD	A,13
	JP	GIOCL

SOUND:
	POP	BC
	POP	HL
	LD	(SAMP),HL
	POP	HL
	LD	(SPER),HL
	POP	HL
	LD	(SCHN),HL
	PUSH	HL
	LD	HL,(SPER)
	PUSH	HL
	LD	HL,(SAMP)
	PUSH	HL
	PUSH	BC
	LD	A,(SCHN)
	CP	0
	JP	Z,NOSND
	CP	5
	JP	Z,SENV
	CP	6
	RET	NC
	CP	3
	JP	Z,SNOIS
	CP	1
	JP	Z,SCHA
	CP	2
	JP	Z,SCHB
	CP	4
	JP	Z,SCHC
	RET

SCHA:
	LD	A,0
	LD	(SREG),A
	LD	A,8
	LD	(SAREG),A
	LD	A,0FEH
	LD	(SMASK),A
	JP	STONE

SCHB:
	LD	A,2
	LD	(SREG),A
	LD	A,9
	LD	(SAREG),A
	LD	A,0FDH
	LD	(SMASK),A
	JP	STONE

SCHC:
	LD	A,4
	LD	(SREG),A
	LD	A,10
	LD	(SAREG),A
	LD	A,0FBH
	LD	(SMASK),A
	JP	STONE

STONE:
	LD	A,(SREG)
	OUT	(16H),A
	LD	HL,(SPER)
	LD	A,L
	OUT	(17H),A
	LD	A,(SREG)
	INC	A
	OUT	(16H),A
	LD	A,H
	OUT	(17H),A
	LD	A,(SAREG)
	OUT	(16H),A
	LD	A,(SAMP)
	OUT	(17H),A
	LD	A,7
	OUT	(16H),A
	IN	A,(17H)
	LD	B,A
	LD	A,(SMASK)
	AND	B
	OUT	(17H),A
	RET

SNOIS:
	LD	A,6
	OUT	(16H),A
	LD	HL,(SPER)
	LD	A,L
	OUT	(17H),A
	LD	A,7
	OUT	(16H),A
	IN	A,(17H)
	OR	38H
	LD	C,A
	LD	A,(SAMP)
	RLCA
	RLCA
	RLCA
	CPL
	AND	C
	OUT	(17H),A
	RET

SENV:
	LD	HL,(SPER)
	LD	A,11
	OUT	(16H),A
	LD	A,L
	OUT	(17H),A
	LD	A,12
	OUT	(16H),A
	LD	A,H
	OUT	(17H),A
	LD	A,13
	OUT	(16H),A
	LD	A,(SAMP)
	CPL
	OUT	(17H),A
	RET

NOSND:
	LD	A,7
	OUT	(16H),A
	LD	A,03FH
	OUT	(17H),A
	LD	A,8
	OUT	(16H),A
	XOR	A
	OUT	(17H),A
	LD	A,9
	OUT	(16H),A
	XOR	A
	OUT	(17H),A
	LD	A,10
	OUT	(16H),A
	XOR	A
	OUT	(17H),A
	RET

AYREG:
	OUT	(16H),A
	RET

AYWR:
	OUT	(16H),A
	LD	A,E
	OUT	(17H),A
	RET

SCHN:	DW	0000H
SPER:	DW	0000H
SAMP:	DW	0000H
SREG:	DB	00H
SAREG:	DB	00H
SMASK:	DB	00H

TSCALE:
	DW	956,902,852,804,759,716,676,638,602,568,537,506
	DW	478,451,426,402,379,358,338,319,301,284,268,253
	DW	239,226,213,201,190,179,169,160,151,142,134,127
	DW	120,0

HARDCOPY:
	LD	A,18
	JP	GIOCL

TXTDIR:
	POP	DE
	POP	HL
	PUSH	HL
	PUSH	DE
	LD	(G1),HL
	LD	A,17
	JP	GIOCL

GETBAR:
	LD	HL,6
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(G1),DE
	LD	HL,4
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(G2),DE
	LD	HL,2
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(G3),DE
	LD	A,22
	CALL	GIOCL
	LD	HL,(G1)
	RET

PUTBAR:
	LD	HL,6
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(G1),DE
	LD	HL,4
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(G2),DE
	LD	HL,2
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(G3),DE
	LD	A,21
	CALL	GIOCL
	LD	HL,(G1)
	RET

VIEWPORT:
	POP	BC
	POP	HL
	POP	DE
	PUSH	DE
	PUSH	HL
	PUSH	BC
	LD	(XO),DE
	LD	(YO),HL
	RET

GIO:
	POP	BC
	POP	HL
	POP	DE
	PUSH	DE
	PUSH	HL
	PUSH	BC
	LD	(PF),DE
	LD	(PG),HL
	CALL	LRT
	RET

